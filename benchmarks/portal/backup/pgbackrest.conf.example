[global]
repo1-type=s3
repo1-s3-bucket=genro-backups
repo1-s3-endpoint=fsn1.your-objectstorage.com
repo1-s3-region=fsn1
repo1-s3-uri-style=path
repo1-path=/postgres/benchmark
repo1-s3-key=REPLACE_FROM_1PASSWORD
repo1-s3-key-secret=REPLACE_FROM_1PASSWORD
repo1-retention-full=2
repo1-bundle=y
compress-type=gz
process-max=1
start-fast=y
log-level-console=info
log-level-file=off

[benchmark]
pg1-path=/var/lib/postgresql/data
pg1-socket-path=/var/run/postgresql
pg1-user=benchmark
pg1-database=benchmark
